<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.shopsphere.model.Address" %><% List<Address> addresses=(List<Address>)request.getAttribute("addresses"); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Addresses — ShopSphere</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/app.css"></head><body><main class="container"><div class="page-header"><div><span class="eyebrow">ACCOUNT</span><h1>Saved addresses</h1></div><a class="button secondary" href="<%=request.getContextPath()%>/products">Storefront</a></div><div class="grid-2"><section class="card"><h2>Add shipping address</h2><form method="post" action="<%=request.getContextPath()%>/addresses"><label>Address<input name="addressLine" maxlength="255" required></label><label>City<input name="city" maxlength="100" required></label><label>State<input name="state" maxlength="100" required></label><label>Pincode<input name="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button class="button" type="submit">Save address</button></form></section><section class="card"><h2>Your addresses</h2><% if(addresses==null||addresses.isEmpty()){ %><p class="muted">No saved addresses yet.</p><% } else { for(Address a:addresses){ %><article class="list-row"><div><strong><%=a.getAddressLine()%></strong><div class="muted"><%=a.getCity()%>, <%=a.getState()%> — <%=a.getPincode()%></div></div><form method="post" action="<%=request.getContextPath()%>/addresses"><input type="hidden" name="action" value="delete"><input type="hidden" name="addressId" value="<%=a.getAddressId()%>"><button class="button danger" type="submit">Delete</button></form></article><% }} %></section></div></main></body></html>
