<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Wishlist — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><main class="container section"><div class="section-head"><div><span class="eyebrow">SAVED ITEMS</span><h2>My wishlist</h2></div><a class="btn ghost" href="${pageContext.request.contextPath}/products">← Shop more</a></div><c:choose><c:when test="${empty products}"><div class="card empty"><h3>Your wishlist is empty</h3><p class="muted">Save products here for later.</p></div></c:when><c:otherwise><div class="grid"><c:forEach var="product" items="${products}"><article class="product-card"><div class="product-image">♡</div><div class="product-body"><span class="chip">${product.brand}</span><div class="product-title">${product.name}</div><div class="price">₹${product.price}</div><small class="muted">${product.stock} units available</small><div class="product-actions"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="quantity" value="1"><button type="submit">Add to cart</button></form><form method="post" action="${pageContext.request.contextPath}/wishlist"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${product.productId}"><button class="btn danger" type="submit">Remove</button></form></div></div></article></c:forEach></div></c:otherwise></c:choose></main></body></html>