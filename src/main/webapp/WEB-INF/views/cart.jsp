<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.shopsphere.model.CartItem" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cart — ShopSphere</title><link rel="stylesheet" href="\${pageContext.request.contextPath}/assets/css/app.css"></head><body><nav class="nav"><div class="container nav-inner"><a class="brand" href="\${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><div class="navlinks"><a href="\${pageContext.request.contextPath}/products">Shop</a><a href="\${pageContext.request.contextPath}/wishlist">Wishlist</a><a href="\${pageContext.request.contextPath}/orders">Orders</a></div></div></nav><main class="container section"><div class="section-head"><div><span class="eyebrow">YOUR BAG</span><h2>Shopping cart</h2></div><a class="btn ghost" href="\${pageContext.request.contextPath}/products">← Continue shopping</a></div><div class="card"><% double total=0; List<CartItem> items=(List<CartItem>)request.getAttribute("items"); if(items.isEmpty()){ %><div class="empty"><h3>Your cart is empty</h3><p class="muted">Add something from the store to get started.</p><a class="btn" href="\${pageContext.request.contextPath}/products">Browse products</a></div><% } else { for(CartItem x:items){ total+=x.getSubtotal(); %><div class="cart-row"><div><strong><%=x.getProductName()%></strong><div class="muted">₹<%=x.getPrice()%> each</div></div><form method="post" action="\${pageContext.request.contextPath}/cart" class="inline"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="<%=x.getProductId()%>"><input style="width:90px" type="number" name="quantity" min="1" value="<%=x.getQuantity()%>" required><button class="btn secondary" type="submit">Update</button></form><div><strong>₹<%=x.getSubtotal()%></strong><form method="post" action="\${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="<%=x.getProductId()%>"><button class="btn danger" type="submit">Remove</button></form></div></div><% } %><div class="summary"><div class="summary-line"><span>Subtotal</span><strong>₹<%=total%></strong></div><div class="summary-line"><span>Shipping</span><strong>Free</strong></div><div class="summary-line summary-total"><span>Total</span><span>₹<%=total%></span></div><a class="btn" style="width:100%;margin-top:1rem" href="\${pageContext.request.contextPath}/checkout">Proceed to checkout →</a></div><% } %></div></main></body></html>