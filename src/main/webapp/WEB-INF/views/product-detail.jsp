<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.shopsphere.model.Product,java.util.List,java.util.Map,com.shopsphere.model.User" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${product.name} — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><nav class="nav"><div class="container nav-inner"><a class="brand" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><div class="navlinks"><a href="${pageContext.request.contextPath}/products">Shop</a><a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/wishlist">Wishlist</a><a href="${pageContext.request.contextPath}/orders">Orders</a></div></div></nav><main class="container section"><a href="${pageContext.request.contextPath}/products" class="muted">← Back to store</a><div class="detail-grid card" style="margin-top:1rem"><div class="product-image detail-image">◈</div><div><span class="chip">${product.brand}</span><h1>${product.name}</h1><p class="muted">${product.description}</p><div class="price">₹${product.price}</div><p><span class="chip">${product.stock} in stock</span></p><% if(((Product)request.getAttribute("product")).getStock()>0){ %><form method="post" action="${pageContext.request.contextPath}/cart" class="inline"><input type="hidden" name="productId" value="${product.productId}"><input type="number" name="quantity" value="1" min="1" max="${product.stock}" style="width:90px"><button>Add to cart →</button></form><% } %></div></div><div class="section-head" style="margin-top:2rem"><div><span class="eyebrow">REVIEWS</span><h2>Customer feedback</h2></div></div><div class="grid review-grid"><% List<Map<String,Object>> reviews=(List<Map<String,Object>>)request.getAttribute("reviews"); if(reviews==null||reviews.isEmpty()){%><div class="card empty"><h3>No reviews yet</h3><p class="muted">Be the first customer to review this product.</p></div><%}else{for(Map<String,Object> r:reviews){%><article class="card"><strong><%=r.get("name")%></strong><div class="rating">★ <%=r.get("rating")%>/5</div><p><%=r.get("reviewText")==null?"":r.get("reviewText")%></p><small class="muted"><%=r.get("createdAt")%></small></article><%}}%></div><% User u=(User)session.getAttribute("loggedInUser"); if(u!=null){ %><div class="card" style="margin-top:1rem"><h3>Write a review</h3><form method="post" action="${pageContext.request.contextPath}/reviews"><input type="hidden" name="productId" value="${product.productId}"><div class="field"><label>Rating</label><select name="rating" required><option value="5">5 — Excellent</option><option value="4">4 — Great</option><option value="3">3 — Good</option><option value="2">2 — Fair</option><option value="1">1 — Poor</option></select></div><div class="field"><label>Your review</label><textarea name="reviewText" rows="4" maxlength="1000"></textarea></div><button type="submit">Publish review</button></form></div><% } %></main></body></html>