<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.shopsphere.model.Product" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Products — ShopSphere Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><div class="admin-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/admin">Shop<span>Sphere</span></a><a class="side-link" href="${pageContext.request.contextPath}/admin">▦ Dashboard</a><a class="side-link" href="${pageContext.request.contextPath}/admin/products">◈ Products</a><a class="side-link" href="${pageContext.request.contextPath}/admin/categories">◇ Categories</a><a class="side-link" href="${pageContext.request.contextPath}/products">↗ Store</a></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">CATALOG</span><h1>Products</h1><p class="muted">Manage your store catalog.</p></div></div><div class="card" style="margin-bottom:1.2rem"><h3>Add product</h3><form method="post" action="${pageContext.request.contextPath}/admin/products"><input type="hidden" name="action" value="create"><div class="grid"><div class="field"><label>Category</label><select name="categoryId" required><% for(String[] c:(List<String[]>)request.getAttribute("categories")){if("true".equals(c[3])){ %><option value="<%=c[0]%>"><%=c[1]%></option><% }} %></select></div><div class="field"><label>Product name</label><input name="name" required></div><div class="field"><label>Brand</label><input name="brand"></div><div class="field"><label>Price</label><input name="price" type="number" step="0.01" min="0" required></div><div class="field"><label>Discount %</label><input name="discount" type="number" step="0.01" min="0" value="0"></div><div class="field"><label>Stock</label><input name="stock" type="number" min="0" value="0" required></div></div><div class="field"><label>Image URL</label><input name="imageUrl"></div><div class="field"><label>Description</label><textarea name="description" rows="3"></textarea></div><button type="submit">Create product</button></form></div><div class="toolbar"><h2>Catalog</h2><input class="search" data-search="#adminProducts" placeholder="Search products…"></div><div id="adminProducts" class="table-wrap"><table><tr><th>Product</th><th>Price</th><th>Stock</th><th>Action</th></tr><% List<Product> products=(List<Product>)request.getAttribute("products"); for(Product p:products){ %><tr data-search-item><td><strong><%=p.getName()%></strong><div class="muted"><%=p.getBrand()==null?"":p.getBrand()%></div></td><td>₹<%=p.getPrice()%></td><td><span class="chip"><%=p.getStock()%></span></td><td><a class="btn secondary" href="${pageContext.request.contextPath}/admin/products?action=edit&id=<%=p.getProductId()%>">Edit</a> <a class="btn danger" data-confirm="Disable this product?" href="${pageContext.request.contextPath}/admin/products?action=delete&id=<%=p.getProductId()%>">Disable</a></td></tr><% } %></table></div></main></div><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html>