<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.shopsphere.model.User" %><% User u=(User)request.getAttribute("profile"); %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Profile — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><nav class="nav"><div class="container nav-inner"><a class="brand" href="${pageContext.request.contextPath}/">Shop<span>Sphere</span></a><div class="navlinks"><a href="${pageContext.request.contextPath}/products">Shop</a><a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/orders">Orders</a></div></div></nav><main class="container form-shell"><div class="card"><span class="eyebrow">ACCOUNT</span><h1 class="form-title">My profile</h1><p class="muted">Keep your account information up to date.</p><%if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><%if(request.getAttribute("success")!=null){%><div class="alert success"><%=request.getAttribute("success")%></div><%}%><form method="post"><div class="field"><label>Full name</label><input name="name" value="<%=u.getName()%>" required></div><div class="field"><label>Email</label><input value="<%=u.getEmail()%>" disabled></div><div class="field"><label>Mobile</label><input name="mobile" value="<%=u.getMobile()==null?"":u.getMobile()%>"></div><button type="submit" style="width:100%">Save changes</button></form><p><a class="button secondary" href="<%=request.getContextPath()%>/password">Change password</a></p></div></main></body></html>