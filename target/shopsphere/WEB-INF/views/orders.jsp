<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><!doctype html><html><body><h1>My Orders</h1><table border="1"><tr><th>ID</th><th>Total</th><th>Payment</th><th>Payment Status</th><th>Order Status</th><th>Date</th></tr><% for(Map<String,Object> o:(List<Map<String,Object>>)request.getAttribute("orders")){ %><tr><td><%=o.get("orderId")%></td><td>₹<%=o.get("total")%></td><td><%=o.get("paymentMethod")%></td><td><%=o.get("paymentStatus")%></td><td><%=o.get("orderStatus")%></td><td><%=o.get("createdAt")%></td></tr><% } %></table><a href="${pageContext.request.contextPath}/products">Shop</a></body></html>